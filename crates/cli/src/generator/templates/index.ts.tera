const DEFAULT_KILL_SWITCH_POLL_MS = 30_000;
/** Spread deploy-time fetches across pods (0..5s before first background refresh). */
const DEFAULT_KILL_SWITCH_INIT_JITTER_MS = 5_000;
/** Added to each poll interval (30s + 0..10s) to avoid aligned CDN requests. */
const DEFAULT_KILL_SWITCH_POLL_JITTER_MS = 10_000;

const DEFAULT_ARTIFACT_POLL_MS = 60_000;
const DEFAULT_ARTIFACT_INIT_JITTER_MS = 10_000;
const DEFAULT_ARTIFACT_POLL_JITTER_MS = 15_000;

export class Evaluator {
