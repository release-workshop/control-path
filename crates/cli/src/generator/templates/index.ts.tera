  async evaluateBatch<T extends readonly FlagName[]>(
    flagNames: T,
    attributes?: Attributes
  ): Promise<{
    [K in T[number]]: FlagReturnTypes[K]
  }> {
    await this.ensureInitialized();

    try {
      const evalAttributes = this.resolveAttributes(attributes);
      if (!evalAttributes) {
        return this.getDefaults(flagNames) as any;
      }

      const results: Record<string, boolean> = {};
      for (const camelName of flagNames) {
        const flagInfo = this.getFlagInfo(camelName);
        if (!flagInfo) {
          results[camelName] = this.getDefaultForFlag(camelName);
          continue;
        }

        try {
          if (!this.artifact) {
            results[camelName] = this.getDefaultForFlag(camelName);
            continue;
          }

          const flagIndex = this.flagNameMap[flagInfo.qualifiedName];
          if (flagIndex === undefined) {
            results[camelName] = this.getDefaultForFlag(camelName);
            continue;
          }

          results[camelName] = resolveBooleanFlag({
            qualifiedName: flagInfo.qualifiedName,
            flagIndex,
            artifact: this.artifact,
            catalogDefault: flagInfo.defaultValue,
            killSwitchFile: this.killSwitchCoordinator.getState().file,
            attributes: evalAttributes,
          });
        } catch {
          results[camelName] = this.getDefaultForFlag(camelName);
        }
      }

      return results as { [K in T[number]]: FlagReturnTypes[K] };
    } catch {
      return this.getDefaults(flagNames) as any;
    }
  }

  async evaluateAll(
    attributes?: Attributes
  ): Promise<FlagReturnTypes> {
    const flagNames: FlagName[] = [{% for name in flag_names %}{% if not loop.first %}, {% endif %}{{ name }}{% endfor %}];
    return this.evaluateBatch(flagNames as readonly FlagName[], attributes);
  }

  private getDefaults(flagNames: readonly FlagName[]): Partial<FlagReturnTypes> {
    const defaults: Partial<FlagReturnTypes> = {};
    for (const flagName of flagNames) {
      defaults[flagName] = this.getDefaultForFlag(flagName);
    }
    return defaults;
  }

  private getDefaultForFlag(flagName: FlagName): boolean {
    const flagInfo = this.getFlagInfo(flagName);
    if (!flagInfo) {
      return false;
    }
    return flagInfo.defaultValue;
  }

  private getFlagInfo(flagName: FlagName): { qualifiedName: string; defaultValue: boolean } | null {
    const flagInfoMap: Record<FlagName, { qualifiedName: string; defaultValue: boolean }> = {
{% for flag in flags %}
      '{{ flag.camel_name }}': { qualifiedName: '{{ flag.qualified_name }}', defaultValue: {{ flag.default_value }} },
{% endfor %}
    };
    return flagInfoMap[flagName] || null;
  }

  private resolveAttributes(attributes?: Attributes): Attributes | null {
    const resolvedAttributes = attributes ?? this.storedAttributes;

    if (!resolvedAttributes || !resolvedAttributes.id || (typeof resolvedAttributes.id === 'string' && resolvedAttributes.id.trim() === '')) {
      return null;
    }

    return resolvedAttributes;
  }
